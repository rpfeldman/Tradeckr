<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GENAP_MAUI.CustomViews.DoubleActionDialogPopup"
             xmlns:local="clr-namespace:GENAP_MAUI"
             x:Class="GENAP_MAUI.CustomViews.DoubleActionDialogPopup.DoubleActionDialogPopup"
             x:DataType="vm:DoubleActionDialogPopupViewModel"
             BackgroundColor="Transparent">

    <Border Style="{StaticResource DialogCard}">
        <Grid RowDefinitions="Auto,Auto">

            <BoxView Grid.Row="0" Style="{StaticResource DialogAccentBar}" />

            <VerticalStackLayout Grid.Row="1" Spacing="0" Padding="24,18,20,24">

                <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Ellipse Style="{StaticResource DialogStatusDot}" />
                        <Label Text="TRADECKR" Style="{StaticResource DialogEyebrow}" />
                    </HorizontalStackLayout>

                    <Button Grid.Column="1"
                            Text="{x:Static local:Symbols.CloseIcon}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource DialogCloseButton}" />
                </Grid>

                <BoxView Style="{StaticResource DialogDivider}" Margin="0,12,4,0" />

                <Label Text="{Binding Title}"
                       Style="{StaticResource DialogTitle}"
                       Margin="0,16,4,0" />

                <Label Text="{Binding Content}"
                       Style="{StaticResource DialogContent}"
                       Margin="0,8,4,0" />

                <VerticalStackLayout Spacing="10" Margin="0,24,4,0">
                    <Button Text="{Binding FirstOptionText}"
                            Command="{Binding FirstOptionCommand}"
                            Style="{StaticResource DialogButtonBrand}" />

                    <Button Text="{Binding SecondOptionText}"
                            Command="{Binding SecondOptionCommand}"
                            Style="{StaticResource DialogButtonOutline}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
