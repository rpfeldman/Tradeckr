<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GENAP_MAUI.CustomViews.AlertDialogPopup"
             x:DataType="vm:AlertDialogPopupViewModel"
             x:Class="GENAP_MAUI.CustomViews.AlertDialogPopup.AlertDialogPopup">
    
    <Border WidthRequest="320"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
            Padding="20"
            StrokeShape="RoundRectangle 16">
        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding Title}"></Label>
            <Label Text="{Binding Content}" />
            <Button Text="{Binding ButtonText}" Command="{Binding CloseCommand}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
