<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GENAP_MAUI.CustomViews.AlertDialogPopup"
             x:DataType="vm:AlertDialogPopupViewModel"
             x:Class="GENAP_MAUI.CustomViews.AlertDialogPopup.AlertDialogPopup"
             BackgroundColor="Transparent">

    <Border Style="{StaticResource DialogCard}">
        <Grid RowDefinitions="Auto,Auto">

            <BoxView Grid.Row="0" Style="{StaticResource DialogAccentBar}" />

            <VerticalStackLayout Grid.Row="1" Spacing="0" Padding="24,20,24,24">

                <HorizontalStackLayout Spacing="8">
                    <Ellipse Style="{StaticResource DialogStatusDot}" />
                    <Label Text="TRADECKR" Style="{StaticResource DialogEyebrow}" />
                </HorizontalStackLayout>

                <BoxView Style="{StaticResource DialogDivider}" Margin="0,14,0,0" />
                
                <Label Text="{Binding Title}"
                       Style="{StaticResource DialogTitle}"
                       Margin="0,16,0,0" />

                <Label Text="{Binding Content}"
                       Style="{StaticResource DialogContent}"
                       Margin="0,8,0,0" />

                <Button Text="{Binding ButtonText}"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource DialogButtonBrand}"
                        Margin="0,24,0,0" />

            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
