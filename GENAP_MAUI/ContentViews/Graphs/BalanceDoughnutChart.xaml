<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="GENAP_MAUI.ContentViews.Graphs.BalanceDoughnutChart"
             x:Name="Root">

    <VerticalStackLayout Spacing="8">
        <Label x:Name="TitleLabel" Style="{StaticResource ChartTitle}" IsVisible="False" />

        <Grid HeightRequest="340">

            <Label x:Name="BalanceLabel"
                   IsVisible="{Binding HasData, Source={x:Reference Root}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontSize="16"
                   Margin="0,0,0,30"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   TranslationY="-1"
                   InputTransparent="True">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Balance:&#10;" FontAttributes="Bold" />
                        <Span x:Name="BalanceIntegerSpan" Text="0" FontAttributes="Bold" />
                        <Span x:Name="BalanceDecimalSpan" Text="$" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <lvc:PieChart
                IsVisible="{Binding HasData, Source={x:Reference Root}}"
                Series="{Binding DoughnutChart, Source={x:Reference Root}}"
                LegendPosition="Bottom"
                BackgroundColor="Transparent" />

            <Label IsVisible="{Binding IsEmpty, Source={x:Reference Root}}"
                   Text="Sin movimientos para mostrar el balance"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        </Grid>
    </VerticalStackLayout>

</ContentView>