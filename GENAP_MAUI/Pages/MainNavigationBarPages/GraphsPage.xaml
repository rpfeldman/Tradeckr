<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GENAP_MAUI.ViewModels"
             xmlns:charts="clr-namespace:GENAP_MAUI.ContentViews.Graphs"
             xmlns:nav="clr-namespace:GENAP_MAUI.ContentViews.Navigation"
             xmlns:local="clr-namespace:GENAP_MAUI"
             xmlns:strings="clr-namespace:GENAP_MAUI.Resources.Strings"
             x:Class="GENAP_MAUI.Pages.MainNavigationBarPages.GraphsPage"
             x:DataType="vm:GraphsPageViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">
    
    <Grid RowDefinitions="Auto,*">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="OrientationStates">

                <VisualState x:Name="Portrait">
                    <VisualState.StateTriggers>
                        <OrientationStateTrigger Orientation="Portrait" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="Landscape">
                    <VisualState.StateTriggers>
                        <OrientationStateTrigger Orientation="Landscape" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="FiltersGrid" Property="Margin" Value="20,8,20,4" />
                        <Setter TargetName="PeriodFilter" Property="Grid.ColumnSpan" Value="1" />
                        <Setter TargetName="CurrencyFilter" Property="Grid.Row" Value="0" />
                        <Setter TargetName="CurrencyFilter" Property="Grid.Column" Value="1" />
                        <Setter TargetName="CurrencyFilter" Property="Grid.ColumnSpan" Value="1" />
                        <Setter TargetName="LandscapeHint" Property="IsVisible" Value="False" />

                        <Setter TargetName="PeriodFilter" Property="Padding" Value="14,4" />
                        <Setter TargetName="CurrencyFilter" Property="Padding" Value="14,4" />
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="FiltersGrid"
              Grid.Row="0"
              ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="10"
              RowSpacing="6"
              Margin="20,16,20,8">

            <Border x:Name="PeriodFilter"
                    Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource InputField}">
                <Picker x:Name="PeriodPicker"
                        Title="{x:Static strings:AppResources.PickTimePeriod_PickerTitle}"
                        ItemsSource="{x:Static local:GlobalResources.TimePeriodsList}"
                        ItemDisplayBinding="{Binding Value}"
                        SelectedItem="{Binding PickedTimePeriod}" />
            </Border>

            <Border x:Name="CurrencyFilter"
                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource CurrencyPickerField}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label x:Name="CurrencyHint"
                           Grid.Column="0" Text="{x:Static strings:AppResources.PickerDisplay_caption}"
                           Style="{StaticResource CurrencyPickerHint}" />
                    <Picker x:Name="CurrencyPicker"
                            Grid.Column="1"
                            Style="{StaticResource CurrencyPickerControl}"
                            ItemsSource="{x:Static local:GlobalResources.Currencies}"
                            ItemDisplayBinding="{Binding CurrencyDisplayName}"
                            SelectedItem="{Binding PickedCurrency}" />
                </Grid>
            </Border>

        </Grid>

        <ScrollView x:Name="ChartsScroll" Grid.Row="1" Padding="20,8,20,120">
            <VerticalStackLayout Spacing="0">

                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static strings:AppResources.GraphsPage_Title}" Style="{StaticResource SubHeadline}" />
                    <Label x:Name="LandscapeHint"
                           Style="{StaticResource Caption}"
                           HorizontalTextAlignment="Center"
                           Text="{x:Static strings:AppResources.GraphsPage_SubTitle}" />
                </VerticalStackLayout>

                <Label Text="{x:Static strings:AppResources.GeneralCharts_ChartSection}" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:BalanceDoughnutChart Transactions="{Binding TransactionsLog}" UpTitle="{x:Static strings:AppResources.Income_ChartVariable}" DownTitle="{x:Static strings:AppResources.Expenses_ChartVariable}" Title="{x:Static strings:AppResources.BalanceDoughnutChart_ChartTitle}" SubtractTradingLossFromIncome="True"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:BalanceLineChart Transactions="{Binding TransactionsLog}" Title="{x:Static strings:AppResources.BalanceLineChart_ChartTitle}"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{x:Static strings:AppResources.TradingCharts_ChartSection}" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:BalanceDoughnutChart Transactions="{Binding TradingLog}" UpTitle="{x:Static strings:AppResources.Gains_ChartVariable}" DownTitle="{x:Static strings:AppResources.Losses_ChartVariable}" Title="{x:Static strings:AppResources.PnlDoughnutChart_ChartTitle}" SubtractTradingLossFromIncome="False"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:BalanceLineChart Transactions="{Binding TradingLog}" Title="{x:Static strings:AppResources.PnlLineChart_ChartTitle}"></charts:BalanceLineChart>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:DailyColumnChart Transactions="{Binding TradingLog}" Title="{x:Static strings:AppResources.PnlColumnChart_ChartTitle}"></charts:DailyColumnChart>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{x:Static strings:AppResources.Expenses_ChartSection}" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:ProportionDoughnutChart Categories="{Binding Categories}" Transactions="{Binding ExpensesLog}" Title="{x:Static strings:AppResources.ExpensesDoughnutChart_ChartTitle}"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:BasicLineChart Transactions="{Binding ExpensesLog}" LineColor="{StaticResource ExpenseRed}" Title="{x:Static strings:AppResources.ExpensesLineChart_ChartTitle}" InvertYAxis="True"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{x:Static strings:AppResources.Income_ChartSection}" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:ProportionDoughnutChart Categories="{Binding Categories}" Transactions="{Binding IncomeLog}" Title="{x:Static strings:AppResources.IncomeDoughnutChart_ChartTitle}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:BasicLineChart Transactions="{Binding IncomeLog}" LineColor="{StaticResource IncomeGreen}" Title="{x:Static strings:AppResources.IncomeLineChart_ChartTitle}"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <nav:BottomNavigationBar Grid.Row="0" Grid.RowSpan="2" />
    </Grid>

</ContentPage>
