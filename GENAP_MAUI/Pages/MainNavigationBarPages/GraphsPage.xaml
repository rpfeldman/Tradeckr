<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GENAP_MAUI.ViewModels"
             xmlns:charts="clr-namespace:GENAP_MAUI.ContentViews.Graphs"
             xmlns:nav="clr-namespace:GENAP_MAUI.ContentViews.Navigation"
             xmlns:local="clr-namespace:GENAP_MAUI"
             x:Class="GENAP_MAUI.Pages.MainNavigationBarPages.GraphsPage"
             x:DataType="vm:GraphsPageViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <Grid RowDefinitions="Auto,*">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="OrientationStates">

                <VisualState x:Name="Portrait">
                    <VisualState.StateTriggers>
                        <OrientationStateTrigger Orientation="Portrait" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="Landscape">
                    <VisualState.StateTriggers>
                        <OrientationStateTrigger Orientation="Landscape" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="FiltersGrid" Property="Margin" Value="20,8,20,4" />
                        <Setter TargetName="PeriodFilter" Property="Grid.ColumnSpan" Value="1" />
                        <Setter TargetName="CurrencyFilter" Property="Grid.Row" Value="0" />
                        <Setter TargetName="CurrencyFilter" Property="Grid.Column" Value="1" />
                        <Setter TargetName="CurrencyFilter" Property="Grid.ColumnSpan" Value="1" />
                        <Setter TargetName="LandscapeHint" Property="IsVisible" Value="False" />

                        <Setter TargetName="PeriodFilter" Property="Padding" Value="14,4" />
                        <Setter TargetName="CurrencyFilter" Property="Padding" Value="14,4" />
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="FiltersGrid"
              Grid.Row="0"
              ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="10"
              RowSpacing="6"
              Margin="20,16,20,8">

            <Border x:Name="PeriodFilter"
                    Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource InputField}">
                <Picker x:Name="PeriodPicker"
                        Title="Seleccionar período de tiempo"
                        ItemsSource="{x:Static local:GlobalResources.TimePeriodsList}"
                        ItemDisplayBinding="{Binding Value}"
                        SelectedItem="{Binding PickedTimePeriod}" />
            </Border>

            <Border x:Name="CurrencyFilter"
                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource CurrencyPickerField}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label x:Name="CurrencyHint"
                           Grid.Column="0" Text="Ver en"
                           Style="{StaticResource CurrencyPickerHint}" />
                    <Picker x:Name="CurrencyPicker"
                            Grid.Column="1"
                            Style="{StaticResource CurrencyPickerControl}"
                            ItemsSource="{x:Static local:GlobalResources.Currencies}"
                            ItemDisplayBinding="{Binding CurrencyDisplayName}"
                            SelectedItem="{Binding PickedCurrency}" />
                </Grid>
            </Border>

        </Grid>

        <ScrollView x:Name="ChartsScroll" Grid.Row="1" Padding="20,8,20,120">
            <VerticalStackLayout Spacing="0">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Apartado de graficos" Style="{StaticResource SubHeadline}" />
                    <Label x:Name="LandscapeHint"
                           Style="{StaticResource Caption}"
                           HorizontalTextAlignment="Center"
                           Text="Para una mejor visualizacion se recomienda usar el celular en horizontal." />
                </VerticalStackLayout>

                <Label Text="Balance general" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:BalanceDoughnutChart Transactions="{Binding TransactionsLog}" UpTitle="Ingresos" DownTitle="Gastos" Title="Dona de balance" SubtractTradingLossFromIncome="True"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:BalanceLineChart Transactions="{Binding TransactionsLog}" Title="Evolucion del balance"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Trading" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:BalanceDoughnutChart Transactions="{Binding TradingLog}" UpTitle="Ganancias" DownTitle="Perdidas" Title="Proporcion PnL" SubtractTradingLossFromIncome="False"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:BalanceLineChart Transactions="{Binding TradingLog}" Title="Evolucion PnL"></charts:BalanceLineChart>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:DailyColumnChart Transactions="{Binding TradingLog}" Title="PnL por dia"></charts:DailyColumnChart>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Análisis de gastos cotidianos" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:ProportionDoughnutChart Categories="{Binding Categories}" Transactions="{Binding ExpensesLog}" Title="Gastos por categoria"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:BasicLineChart Transactions="{Binding ExpensesLog}" LineColor="{StaticResource ExpenseRed}" Title="Evolucion del gasto"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Análisis de ingreso neto" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:ProportionDoughnutChart Categories="{Binding Categories}" Transactions="{Binding IncomeLog}" Title="Ingreso neto por categoria" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ChartCard}">
                    <VerticalStackLayout>
                        <charts:BasicLineChart Transactions="{Binding IncomeLog}" LineColor="{StaticResource IncomeGreen}" Title="Evolucion del ingreso neto"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <nav:BottomNavigationBar Grid.Row="0" Grid.RowSpan="2" />
    </Grid>

</ContentPage>
