<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GENAP_MAUI.ViewModels"
             xmlns:model="clr-namespace:DomainModel;assembly=DomainModel"
             xmlns:nav="clr-namespace:GENAP_MAUI.ContentViews.Navigation"
             xmlns:behaviours="clr-namespace:GENAP_MAUI.ControlBehaviours"
             xmlns:local="clr-namespace:GENAP_MAUI"
             xmlns:strings="clr-namespace:GENAP_MAUI.Resources.Strings"
             x:Class="GENAP_MAUI.Pages.MainNavigationBarPages.RegistTransactionPage"
             x:DataType="vm:RegistTransactionPageViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource FormContainer}" Padding="20,20,20,110">

                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static strings:AppResources.NewTransaction_Title}" Style="{StaticResource SubHeadline}" />
                    <Label Style="{StaticResource Caption}"
                           HorizontalTextAlignment="Center"
                           Text="{x:Static strings:AppResources.NewTransaction_SubTitle}" />
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Text="{x:Static strings:AppResources.TransactionValue_Label}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <Label Grid.Column="0" Text="$"
                                   Style="{StaticResource CurrencyPrefix}"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Style="{StaticResource AmountEntry}"
                                   Placeholder="0" Keyboard="Numeric"
                                   Text="{Binding PickedValue}">

                                <Entry.Behaviors>
                                    <behaviours:MoneyEntryBehaviour/>
                                </Entry.Behaviors>
                            </Entry>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CurrencyPickerAttached}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{x:Static strings:AppResources.Currency_PickerLabel}"
                                   Style="{StaticResource CurrencyPickerHint}" />
                            <Picker Grid.Column="1"
                                    Style="{StaticResource CurrencyPickerControl}"
                                    ItemsSource="{x:Static local:GlobalResources.Currencies}"
                                    ItemDisplayBinding="{Binding CurrencyDisplayName}"
                                    SelectedItem="{Binding PickedCurrency}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource NoticeBox}" Margin="0,8,0,20">
                        <Label Style="{StaticResource NoticeText}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static strings:AppResources.RateUpdate_Label}" />
                                    <Span Text="{x:Static local:GlobalResources.LastRateUpdateFormatted}"
                                          FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Text="{x:Static strings:AppResources.Category_Label}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Picker Title="{x:Static strings:AppResources.PickCategory_PickerTitle}"
                                ItemsSource="{Binding Categories}"
                                ItemDisplayBinding="{Binding Name, x:DataType=model:CategoryDto}"
                                SelectedItem="{Binding Category}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Text="{x:Static strings:AppResources.Date_Label}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <DatePicker Date="{Binding PickedDate}" />
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                    Text="{x:Static strings:AppResources.Income_ButtonText}"
                    Style="{StaticResource IncomeChoice}"
                    Command="{Binding SetIncomeCommand}"
                    IsEnabled="{Binding IsExpenseSelected}" />

                    <Button Grid.Column="1"
                    Text="{x:Static strings:AppResources.Expense_ButtonText}"
                    Style="{StaticResource ExpenseChoice}"
                    Command="{Binding SetExpenseCommand}"
                    IsEnabled="{Binding IsIncomeSelected}" />
                </Grid>

                <Border Style="{StaticResource InputField}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{x:Static strings:AppResources.FixedTransaction_Label}"
                               Style="{StaticResource FieldLabel}"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsFixed}"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <VerticalStackLayout IsVisible="{Binding IsFixed}">
                    <Label Text="{x:Static strings:AppResources.Duration_Label}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <Entry Grid.Column="0" Placeholder="Ej. 12"
                                   Keyboard="Numeric"
                                   Text="{Binding FixedTransactionDuration}" />
                            <Label Grid.Column="1" Text="{x:Static strings:AppResources.Months_Caption}"
                                   Style="{StaticResource Caption}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Button Text="{x:Static strings:AppResources.RegistTransacion_Button}"
                        Command="{Binding RegistTransactionCommand}"
                        Style="{StaticResource ButtonPrimary}" />
            </VerticalStackLayout>
        </ScrollView>

        <nav:BottomNavigationBar />

    </Grid>

</ContentPage>