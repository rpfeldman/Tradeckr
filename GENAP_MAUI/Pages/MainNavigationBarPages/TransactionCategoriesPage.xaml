<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GENAP_MAUI.ViewModels"
             xmlns:model="clr-namespace:DomainModel;assembly=DomainModel"
             xmlns:nav="clr-namespace:GENAP_MAUI.ContentViews.Navigation"
             xmlns:local="clr-namespace:GENAP_MAUI"
             xmlns:behaviours="clr-namespace:GENAP_MAUI.ControlBehaviours"
             x:Class="GENAP_MAUI.Pages.MainNavigationBarPages.TransactionCategoriesPage"
             x:DataType="vm:TransactionCategoriesPageViewModel">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="OrientationStates">

                <VisualState x:Name="Portrait">
                    <VisualState.StateTriggers>
                        <OrientationStateTrigger Orientation="Portrait" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="Landscape">
                    <VisualState.StateTriggers>
                        <OrientationStateTrigger Orientation="Landscape" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="Header" Property="IsVisible" Value="False" />
                        <Setter TargetName="NewCategoryCard" Property="Grid.ColumnSpan" Value="1" />
                        <Setter TargetName="SaveButton" Property="Grid.Row" Value="0" />
                        <Setter TargetName="SaveButton" Property="Grid.Column" Value="1" />
                        <Setter TargetName="SaveButton" Property="Grid.ColumnSpan" Value="1" />
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <VerticalStackLayout x:Name="Header" Grid.Row="0" Spacing="4" Padding="20,20,20,0">
            <Label Text="Categorías" Style="{StaticResource SubHeadline}" />
            <Label Style="{StaticResource Caption}"
                   HorizontalTextAlignment="Center"
                   Text="Organizá tus movimientos. Tocá un nombre para editarlo." />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Categories}"
                        ItemsLayout="VerticalList"
                        Margin="20,0,20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:CategoryDto">
                    <Border Style="{StaticResource CategoryCard}" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                            <Border Grid.Column="0"
                                    Style="{StaticResource ColorDot}"
                                    BackgroundColor="{Binding HexColor}"
                                    VerticalOptions="Center" />

                            <Entry Grid.Column="1"
                                   Style="{StaticResource InlineEntry}"
                                   Text="{Binding Name}"
                                   VerticalOptions="Center">

                                <Entry.Behaviors>
                                     <behaviours:CategoryEntryBehaviour/>
                                </Entry.Behaviors>
                            </Entry>

                            <Button Grid.Column="2"
                                    Style="{StaticResource IconButton}"
                                    Text="{x:Static local:Symbols.DeleteIcon}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCategoryCommand}"
                                    CommandParameter="{Binding .}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2"
              ColumnDefinitions="2*,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="12"
              RowSpacing="12"
              Padding="20,0,20,0"
              Margin="0,0,0,100">

            <Border x:Name="NewCategoryCard"
                    Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource CategoryCard}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0"
                           Style="{StaticResource InlineEntry}"
                           Placeholder="Nueva categoría"
                           Text="{Binding NewCategory}"
                           VerticalOptions="Center">
                        
                        <Entry.Behaviors>
                            <behaviours:CategoryEntryBehaviour/>
                        </Entry.Behaviors>
                    </Entry>

                        <Picker Grid.Column="1"
                            Title="Color"
                            WidthRequest="80"
                            ItemsSource="{x:Static local:GlobalResources.ColorList}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedItem="{Binding PickedColor}"
                            VerticalOptions="Center" />

                    <Button Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            Text="{x:Static local:Symbols.AddIcon}"
                            TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                            Command="{Binding AddCategoryCommand}"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <Button x:Name="SaveButton"
                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Text="Guardar cambios"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource ButtonPrimary}" />
        </Grid>

        <nav:BottomNavigationBar Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ContentPage>