<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GENAP_MAUI.ViewModels"
             xmlns:local="clr-namespace:GENAP_MAUI"
             xmlns:strings="clr-namespace:GENAP_MAUI.Resources.Strings"
             x:Class="GENAP_MAUI.Pages.SettingsPages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource FormContainer}"
                                 Spacing="26"
                                 Padding="20,22,20,108">

                <VerticalStackLayout Spacing="16" Padding="0">

                    <VerticalStackLayout Spacing="4" Padding="0">
                        <Label Text="{x:Static strings:AppResources.AppearanceSettings_Title}" Style="{StaticResource SettingsSectionTitle}" />
                        <BoxView Style="{StaticResource SettingsDivider}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" Padding="0">
                        <Label Text="{x:Static strings:AppResources.Username_Label}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Text="{Binding PickedUserName}"
                                   Style="{StaticResource BaseEntry}"
                                   Placeholder="{x:Static strings:AppResources.UsernameEntry_PlaceHolder}" />
                        </Border>
                        <Label Style="{StaticResource SettingsHint}"
                               Text="{x:Static strings:AppResources.Username_Caption}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" Padding="0">
                        <Label Text="{x:Static strings:AppResources.Theme_Label}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputField}">
                            <Picker Title="{x:Static strings:AppResources.Theme_Label}"
                                    ItemsSource="{x:Static local:GlobalResources.AppThemesList}"
                                    ItemDisplayBinding="{Binding Value}"
                                    SelectedItem="{Binding PickedTheme}" />
                        </Border>
                        <Label Style="{StaticResource SettingsHint}"
                               Text="{x:Static strings:AppResources.Theme_Caption}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" Padding="0">
                        <Label Text="{x:Static strings:AppResources.Language_Label}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputField}">
                            <Picker Title="{x:Static strings:AppResources.Language_Label}" 
                                    ItemsSource="{Binding LanguagesList}"
                                    ItemDisplayBinding="{Binding Value}"
                                    SelectedItem="{Binding PickedLanguage}"/>
                            
                        </Border>
                        <Label Style="{StaticResource SettingsHint}"
                               Text="{x:Static strings:AppResources.Language_Caption}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
                
                <VerticalStackLayout Spacing="16" Padding="0">

                    <VerticalStackLayout Spacing="4" Padding="0">
                        <Label Text="{x:Static strings:AppResources.MultiCurrencySettings_Title}" Style="{StaticResource SettingsSectionTitle}" />
                        <BoxView Style="{StaticResource SettingsDivider}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" Padding="0">
                        <Label Text="{x:Static strings:AppResources.DailyCurrency_Label}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputField}">
                            <Picker Title="{x:Static strings:AppResources.PickDailyCurrency_PickerTitle}"
                                    ItemsSource="{x:Static local:GlobalResources.Currencies}"
                                    ItemDisplayBinding="{Binding CurrencyDisplayName}"
                                    SelectedItem="{Binding PickedCommonCurrency}" />
                        </Border>
                        <Label Style="{StaticResource SettingsHint}"
                               Text="{x:Static strings:AppResources.DailyCurrency_Caption}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" Padding="0">
                        <Label Text="{x:Static strings:AppResources.TradingCurrency_Label}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputField}">
                            <Picker IsEnabled="False" Title="{x:Static strings:AppResources.PickTradingCurrency_PickerTitle}" />
                        </Border>
                        <Label Style="{StaticResource SettingsHint}"
                               Text="{x:Static strings:AppResources.BaseCurrency_Caption}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" Padding="0">
                        <Label Text="{x:Static strings:AppResources.RatesUpdate_Label}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputField}">
                            <Picker ItemsSource="{Binding UpdateRatesOptionsList}"
                                    ItemDisplayBinding="{Binding Value}"
                                    SelectedItem="{Binding PickedUpdateRateOption}" />
                        </Border>
                        <Label Style="{StaticResource SettingsHint}"
                               Text="{x:Static strings:AppResources.RatesUpdate_Caption}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout Spacing="16" Padding="0">

                    <VerticalStackLayout Spacing="4" Padding="0">
                        <Label Text="{x:Static strings:AppResources.BugReportSettings_Title}" Style="{StaticResource SettingsSectionTitle}" />
                        <BoxView Style="{StaticResource SettingsDivider}" />
                    </VerticalStackLayout>

                    <Label Style="{StaticResource SettingsHint}"
                           Text="{x:Static strings:AppResources.BugReport_Caption}" />

                    <VerticalStackLayout Spacing="6" Padding="0">
                        <Label Text="{x:Static strings:AppResources.BugTitle_Label}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Text="{Binding BugTitle}"
                                   Style="{StaticResource BaseEntry}"
                                   Placeholder="{x:Static strings:AppResources.BugTitleEntry_PlaceHolder}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" Padding="0">
                        <Label Text="{x:Static strings:AppResources.BugDescription_Label}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Text="{Binding BugDescription}"
                                   Style="{StaticResource BaseEntry}"
                                   Placeholder="{x:Static strings:AppResources.BugDescriptionEntry_PlaceHolder}" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="{x:Static strings:AppResources.Report_ButtonText}"
                            Style="{StaticResource ButtonSecondary}"
                            Command="{Binding ReportCommand}"
                            Margin="0,4,0,0" />

                </VerticalStackLayout>

                <VerticalStackLayout Spacing="16" Padding="0">

                    <VerticalStackLayout Spacing="4" Padding="0">
                        <Label Text="{x:Static strings:AppResources.StorageSettings_Title}" Style="{StaticResource SettingsSectionTitle}" />
                        <BoxView Style="{StaticResource SettingsDivider}" />
                    </VerticalStackLayout>

                    <Label Style="{StaticResource SettingsHint}"
                           Text="{x:Static strings:AppResources.ResetStorage_Caption}" />

                    <Button Text="{x:Static strings:AppResources.ResetStorage_ButtonText}"
                            Style="{StaticResource ButtonDangerOutline}"
                            Command="{Binding PushNavigateCommand}"
                            CommandParameter="{x:Static local:Routes.ClearStorageConfirmation}" />

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout VerticalOptions="End"
                             Spacing="0"
                             Padding="0"
                             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">
            <BoxView Style="{StaticResource SettingsDivider}" />
            <Grid Padding="20,12,20,18">
                <Button Text="{x:Static strings:AppResources.SaveChanges_Button}"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding SaveCommand}" />
            </Grid>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
