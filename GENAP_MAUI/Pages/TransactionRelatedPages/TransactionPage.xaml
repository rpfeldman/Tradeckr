<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GENAP_MAUI.ViewModels"
             xmlns:model="clr-namespace:DomainModel;assembly=DomainModel"
             xmlns:local="clr-namespace:GENAP_MAUI"
             xmlns:behaviours="clr-namespace:GENAP_MAUI.ControlBehaviours"
             xmlns:strings="clr-namespace:GENAP_MAUI.Resources.Strings"
             x:Class="GENAP_MAUI.Pages.TransactionRelatedPages.TransactionPage"
             x:DataType="vm:TransactionPageViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormContainer}">

            <Label Text="{x:Static strings:AppResources.TransactionDetail_Title}" Style="{StaticResource SubHeadline}" />
            
            <VerticalStackLayout>
                <Label Text="{x:Static strings:AppResources.TransactionValue_Label}" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputField}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Grid.Column="0" Text="$"
                               Style="{StaticResource CurrencyPrefix}"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                            Style="{StaticResource AmountEntry}"
                            Placeholder="0" Keyboard="Numeric"
                            Text="{Binding PickedValue}">

                            <Entry.Behaviors>
                                <behaviours:MoneyEntryBehaviour/>
                            </Entry.Behaviors>
                        </Entry>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CurrencyPickerAttached}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{x:Static strings:AppResources.Currency_PickerLabel}"
                               Style="{StaticResource CurrencyPickerHint}" />
                        <Picker Grid.Column="1"
                                Style="{StaticResource CurrencyPickerControl}"
                                ItemsSource="{x:Static local:GlobalResources.Currencies}"
                                ItemDisplayBinding="{Binding CurrencyDisplayName}"
                                SelectedItem="{Binding PickedCurrency}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="{x:Static strings:AppResources.Category_Label}" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputField}">
                    <Picker ItemsSource="{Binding Categories}"
                            ItemDisplayBinding="{Binding Name, x:DataType=model:CategoryDto}"
                            SelectedItem="{Binding PickedCategory}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="{x:Static strings:AppResources.Date_Label}" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputField}">
                    <DatePicker Date="{Binding PickedDate}" />
                </Border>
            </VerticalStackLayout>

            <Button Text="{x:Static strings:AppResources.SaveChanges_Button}"
                    Command="{Binding UpdateTransactionCommand}"
                    Style="{StaticResource ButtonPrimary}" />

            <Button Text="{x:Static strings:AppResources.DeleteTransaction_ButtonText}"
                    Command="{Binding DeleteTransactionCommand}"
                    Style="{StaticResource ButtonDestructiveOutline}" />

            <VerticalStackLayout IsVisible="{Binding Transaction.Fixed}" Spacing="8">

                <Label Text="{x:Static strings:AppResources.FixedTransaction_Label}" Style="{StaticResource FieldLabel}" />
                <Label Style="{StaticResource Caption}"
                       Text="{x:Static strings:AppResources.FixedTransactionSeries_Caption}" />

                <Button Text="{x:Static strings:AppResources.DeleteFollowingFixedTransactions_ButtonText}"
                        Command="{Binding DeleteFixedTransactionCommand}"
                        CommandParameter="{x:Boolean True}"
                        Style="{StaticResource ButtonDestructiveOutline}" />

                <Button Text="{x:Static strings:AppResources.DeleteFixedTransactionSeries_ButtonText}"
                        Command="{Binding DeleteFixedTransactionCommand}"
                        CommandParameter="{x:Boolean False}"
                        Style="{StaticResource ButtonDestructiveOutline}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>