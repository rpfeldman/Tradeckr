<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GENAP_MAUI.ViewModels"
             xmlns:model="clr-namespace:DomainModel;assembly=DomainModel"
             xmlns:nav="clr-namespace:GENAP_MAUI.ContentViews.Navigation"
             xmlns:local="clr-namespace:GENAP_MAUI"
             x:Class="GENAP_MAUI.Pages.TransactionRelatedPages.TransactionsCollectionPage"
             x:DataType="vm:TransactionsCollectionPageViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <Grid RowDefinitions="Auto,Auto,*">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="OrientationStates">

                <VisualState x:Name="Portrait">
                    <VisualState.StateTriggers>
                        <OrientationStateTrigger Orientation="Portrait" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="Landscape">
                    <VisualState.StateTriggers>
                        <OrientationStateTrigger Orientation="Landscape" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="HeaderHint" Property="IsVisible" Value="False" />
                        <Setter TargetName="FiltersGrid" Property="Margin" Value="20,8,20,4" />
                        <Setter TargetName="PeriodFilter" Property="Grid.ColumnSpan" Value="1" />
                        <Setter TargetName="CurrencyFilter" Property="Grid.Row" Value="0" />
                        <Setter TargetName="CurrencyFilter" Property="Grid.Column" Value="1" />
                        <Setter TargetName="CurrencyFilter" Property="Grid.ColumnSpan" Value="1" />
                        <Setter TargetName="PeriodFilter" Property="Padding" Value="14,4" />
                        <Setter TargetName="CurrencyFilter" Property="Padding" Value="14,4" />
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="20,20,20,0">
            <Label Text="Movimientos" Style="{StaticResource SubHeadline}" />
            <Label x:Name="HeaderHint"
                   Style="{StaticResource Caption}"
                   HorizontalTextAlignment="Center"
                   Text="Tocá un movimiento para ver el detalle o editarlo." />
        </VerticalStackLayout>

        <Grid x:Name="FiltersGrid"
              Grid.Row="1"
              ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="10"
              RowSpacing="6"
              Margin="20,16,20,8">

            <Border x:Name="PeriodFilter"
                    Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource InputField}">
                <Picker Title="Seleccionar período de tiempo"
                        ItemsSource="{x:Static local:GlobalResources.TimePeriodsList}"
                        ItemDisplayBinding="{Binding Value}"
                        SelectedItem="{Binding PickedTimePeriod}" />
            </Border>

            <Border x:Name="CurrencyFilter"
                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource CurrencyPickerField}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Ver en"
                           Style="{StaticResource CurrencyPickerHint}" />
                    <Picker Grid.Column="1"
                            Style="{StaticResource CurrencyPickerControl}"
                            ItemsSource="{x:Static local:GlobalResources.Currencies}"
                            ItemDisplayBinding="{Binding CurrencyDisplayName}"
                            SelectedItem="{Binding PickedCurrency}" />
                </Grid>
            </Border>

        </Grid>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Transactions}"
                        ItemsLayout="VerticalList"
                        Margin="20,0,20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:TransactionDto">
                    <Border Style="{StaticResource TransactionCard}" Margin="0,0,0,10">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsCollectionPageViewModel}}, Path=NavigateIntoTransactionCommand}"
                                CommandParameter="{Binding Id}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

                            <Border Grid.Column="0"
                                    Style="{StaticResource ColorDot}"
                                    VerticalOptions="Center">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding Depletion}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource IncomeGreen}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding Depletion}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource ExpenseRed}" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2"
                                                 VerticalOptions="Center" Padding="0">
                                <Label Text="{Binding Category}"
                                       Style="{StaticResource FieldLabel}" />
                                <Label Text="{Binding Date, StringFormat='{0:d}'}"
                                       Style="{StaticResource TransactionMeta}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="4"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="End" Padding="0">

                                <Label FontAttributes="Bold"
                                       FontSize="15"
                                       HorizontalTextAlignment="End">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0:N2} {1}$">
                                            <Binding Path="Value" />
                                            <Binding Path="BindingContext.PickedCurrency.IsoCode"
                                                 Source="{RelativeSource AncestorType={x:Type ContentPage}}" />
                                        </MultiBinding>
                                    </Label.Text>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Depletion}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource IncomeGreen}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Depletion}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource ExpenseRed}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Border Style="{StaticResource StatusBadge}"
                                        HorizontalOptions="End">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding Depletion}" Value="False">
                                            <Setter Property="Stroke" Value="{StaticResource IncomeGreen}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding Depletion}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource ExpenseRed}" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Label Style="{StaticResource StatusBadgeText}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Depletion}" Value="False">
                                                <Setter Property="Text" Value="Ingreso" />
                                                <Setter Property="TextColor" Value="{StaticResource IncomeGreen}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Depletion}" Value="True">
                                                <Setter Property="Text" Value="Pérdida" />
                                                <Setter Property="TextColor" Value="{StaticResource ExpenseRed}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </VerticalStackLayout>

                            <Label Grid.Column="3"
                                   Text="›"
                                   FontSize="22"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <ContentView HeightRequest="110" />
            </CollectionView.Footer>
        </CollectionView>

        <nav:BottomNavigationBar Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ContentPage>