<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GENAP_MAUI.ViewModels"
             xmlns:local="clr-namespace:GENAP_MAUI"
             x:Class="GENAP_MAUI.Pages.OnboardingPages.OnboardingPage"
             x:DataType="vm:OnboardingpageViewModel">

    <ScrollView>
        <Grid RowDefinitions="*, Auto, *"
              MinimumHeightRequest="{Binding Height, Source={RelativeSource AncestorType={x:Type ContentPage}}}">

            <VerticalStackLayout Grid.Row="1"
                                 Style="{StaticResource FormContainer}"
                                 Spacing="0"
                                 VerticalOptions="Center">

                <Label Text="Bienvenido a"
                       Style="{StaticResource OnboardingEyebrow}"
                       Margin="0,0,0,4" />

                <Label Text="TRADECKR"
                       Style="{StaticResource OnboardingWordmark}"
                       Margin="0,0,0,28" />

                <Label Style="{StaticResource OnboardingTagline}"
                       Margin="0,0,0,48">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Donde tu gestión financiera deja de ser un " />
                            <Span Text="caos" />
                            <Span Text=" y pasa a ser una " />
                            <Span Text="realidad"
                                  TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                                  FontAttributes="Bold" />
                            <Span Text="." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label Text="Para empezar, ¿cómo te llamás?"
                       Style="{StaticResource FieldLabel}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10" />

                <Border Style="{StaticResource InputFieldBrand}">
                    <Entry Text="{Binding UserName}"
                           Style="{StaticResource BaseEntry}"
                           Placeholder="Tu nombre..."
                           HorizontalTextAlignment="Center"
                           ReturnType="Done"
                           ReturnCommand="{Binding ContinueCommand}" />
                </Border>

                <VerticalStackLayout Spacing="8" Margin="0,28,0,0">
                    <Label Text="¿Qué moneda usás en tu día a día?"
                           Style="{StaticResource PreferencePickerLabel}" />
                    <Border Style="{StaticResource PreferencePickerField}">
                        <Picker Style="{StaticResource PreferencePickerControl}"
                                Title="Elegí tu moneda cotidiana"
                                ItemsSource="{x:Static local:GlobalResources.Currencies}"
                                ItemDisplayBinding="{Binding CurrencyDisplayName}"
                                SelectedItem="{Binding PickedCommonCurrency}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" Margin="0,18,0,0">
                    <Label Text="¿Y con qué moneda operás?"
                           Style="{StaticResource PreferencePickerLabel}" />
                    <Border Style="{StaticResource PreferencePickerField}">
                        <Picker Style="{StaticResource PreferencePickerControl}"
                                Title="Elegí tu moneda de trading"
                                ItemsSource="{x:Static local:GlobalResources.Currencies}"
                                ItemDisplayBinding="{Binding CurrencyDisplayName}"
                                SelectedItem="{Binding PickedTradingCurrency}" />
                    </Border>

                    <Border Style="{StaticResource NoticeBox}" Margin="0,6,0,0">
                        <Label Style="{StaticResource NoticeText}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="IMPORTANTE: " FontAttributes="Bold" />
                                    <Span Text="La moneda que elijas como tu moneda operativa va a convertirse en tu " />
                                    <Span Text="moneda raíz" FontAttributes="Bold" />
                                    <Span Text=". Esto significa que el resto de monedas van a adaptar su conversión a esta moneda. Podés cambiar esto en cualquier momento desde los ajustes." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2"
                                 Style="{StaticResource FormContainer}"
                                 Spacing="0"
                                 VerticalOptions="End">

                <Button Text="Comenzar"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding ContinueCommand}"
                        Margin="0,0,0,10" />

                <Label Text="Es necesario estar conectado a internet la primera vez que ingresás a la aplicación."
                       Style="{StaticResource InlineWarning}"
                       Margin="0,0,0,10" 
                       IsVisible="{Binding InlineWarningVisibily}"/>

                <Label Text="Tu plata, bajo tu control."
                       Style="{StaticResource Caption}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>