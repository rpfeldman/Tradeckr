<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GENAP_MAUI.ViewModels"
             xmlns:local="clr-namespace:GENAP_MAUI"
             xmlns:strings="clr-namespace:GENAP_MAUI.Resources.Strings"
             x:Class="GENAP_MAUI.Pages.OnboardingPages.OnboardingPage"
             x:DataType="vm:OnboardingpageViewModel">

    <ScrollView>
        <Grid RowDefinitions="*, Auto, *"
              MinimumHeightRequest="{Binding Height, Source={RelativeSource AncestorType={x:Type ContentPage}}}">

            <VerticalStackLayout Grid.Row="1"
                                 Style="{StaticResource FormContainer}"
                                 Spacing="0"
                                 VerticalOptions="Center">

                <Label Text="{x:Static strings:AppResources.OnBoardingWelcome_Label}"
                       Style="{StaticResource OnboardingEyebrow}"
                       Margin="0,0,0,4" />

                <Label Text="TRADECKR"
                       Style="{StaticResource OnboardingWordmark}"
                       Margin="0,0,0,28" />

                <Label Style="{StaticResource OnboardingTagline}"
                       Margin="0,0,0,48">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static strings:AppResources.OnBoardingPage_SubTitle_1}"/>
                            
                            <Span Text="{x:Static strings:AppResources.OnBoardingPage_SubTitle_2}"
                                  FontAttributes="Bold"/>
                            
                            <Span Text=".&#10;" />
                            
                            <Span Text="{x:Static strings:AppResources.OnBoardingPage_SubTitle_3}"
                                  TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                                  FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label Text="{x:Static strings:AppResources.PickUsername_Label}"
                       Style="{StaticResource FieldLabel}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10" />

                <Border Style="{StaticResource InputFieldBrand}">
                    <Entry Text="{Binding UserName}"
                           Style="{StaticResource BaseEntry}"
                           Placeholder="{x:Static strings:AppResources.UsernameEntry_PlaceHolder}"
                           HorizontalTextAlignment="Center"
                           ReturnType="Done"
                           ReturnCommand="{Binding ContinueCommand}" />
                </Border>

                <VerticalStackLayout Spacing="8" Margin="0,28,0,0">
                    <Label Text="{x:Static strings:AppResources.PickDailyCurrency_Label}"
                           Style="{StaticResource PreferencePickerLabel}" />
                    <Border Style="{StaticResource PreferencePickerField}">
                        <Picker Style="{StaticResource PreferencePickerControl}"
                                Title="{x:Static strings:AppResources.PickDailyCurrency_PickerTitle}"
                                ItemsSource="{x:Static local:GlobalResources.Currencies}"
                                ItemDisplayBinding="{Binding CurrencyDisplayName}"
                                SelectedItem="{Binding PickedCommonCurrency}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" Margin="0,18,0,0">
                    <Label Text="{x:Static strings:AppResources.PickTradingCurrency_Label}"
                           Style="{StaticResource PreferencePickerLabel}" />
                    <Border Style="{StaticResource PreferencePickerField}">
                        <Picker Style="{StaticResource PreferencePickerControl}"
                                Title="{x:Static strings:AppResources.PickTradingCurrency_PickerTitle}"
                                ItemsSource="{x:Static local:GlobalResources.Currencies}"
                                ItemDisplayBinding="{Binding CurrencyDisplayName}"
                                SelectedItem="{Binding PickedTradingCurrency}" />
                    </Border>

                    <Border Style="{StaticResource NoticeBox}" Margin="0,6,0,0">
                        <Label Style="{StaticResource NoticeText}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static strings:AppResources.CurrenciesNotice_Label_1}"
                                          FontAttributes="Bold"/>

                                    <Span Text="{x:Static strings:AppResources.CurrenciesNotice_Label_2}"/>

                                    <Span Text="{x:Static strings:AppResources.CurrenciesNotice_Label_3}"
                                          FontAttributes="Bold"/>
                                    
                                    <Span Text=". "/>

                                    <Span Text="{x:Static strings:AppResources.CurrenciesNotice_Label_4}"
                                          FontAttributes="Bold"/>

                                    <Span Text="{x:Static strings:AppResources.CurrenciesNotice_Label_5}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2"
                                 Style="{StaticResource FormContainer}"
                                 Spacing="0"
                                 VerticalOptions="End">

                <Button Text="{x:Static strings:AppResources.Start_ButtonText}"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding ContinueCommand}"
                        Margin="0,0,0,10" />

                <Label Text="{x:Static strings:AppResources.InternetConnection_Warning}"
                       Style="{StaticResource InlineWarning}"
                       Margin="0,0,0,10" 
                       IsVisible="{Binding InlineWarningVisibily}"/>

                <Label Text="{x:Static strings:AppResources.Tagline_caption}"
                       Style="{StaticResource Caption}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>